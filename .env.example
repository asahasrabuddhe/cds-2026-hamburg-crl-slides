# Copy to .env. This holds a 1Password reference, not a secret.
#
#   op run --env-file=.env -- npm install
#
# op run resolves the reference against your signed-in 1Password session and
# injects the real value only into the child process's environment. Nothing
# touches disk. .npmrc reads it back out as ${NPM_TOKEN_THEME}.

NPM_TOKEN_THEME=op://Personal/NPM_TOKEN_THEME/password
